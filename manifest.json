{
  "manifest_version": 3,
  "name": "OpEndSkipper",
  "version": "2.1.0",
  "minimum_chrome_version": "119",
  "description": "Автоматично пропускає початок і кінець HTML5-відео за окремими налаштуваннями для кожного URL.",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle",
      "js": [
        "src/shared/constants.js",
        "src/content/video-skipper.js"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/forward-button16.png",
      "48": "assets/icons/forward-button48.png",
      "128": "assets/icons/forward-button128.png"
    }
  },
  "icons": {
    "16": "assets/icons/forward-button16.png",
    "48": "assets/icons/forward-button48.png",
    "128": "assets/icons/forward-button128.png"
  }
}
